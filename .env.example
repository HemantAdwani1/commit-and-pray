# Copy this file to .env.local for local development.
# Never commit .env.local — it is already listed in .gitignore.
#
# Both values below are found in your Supabase project at:
# Project Settings -> API
#
# VITE_SUPABASE_ANON_KEY is the public "anon" key. It is safe to expose in
# a browser bundle ONLY because Row Level Security policies (see
# supabase/migrations/0001_create_contact_requests.sql) restrict it to
# insert-only access on contact_requests.
#
# NEVER put the "service_role" key in this file or anywhere in frontend
# code — it bypasses Row Level Security entirely.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
